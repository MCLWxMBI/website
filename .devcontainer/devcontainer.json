{
  "name": "Node 24",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/website",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "postCreateCommand": "npm install --global @openai/codex",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "vue.volar",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
