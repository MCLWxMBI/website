      "checkConstraints": {
        "opportunities_id_nonempty": {
          "name": "opportunities_id_nonempty",
          "value": "\"opportunities\".\"id\" ~ '[^[:space:]]'"
        },
        "opportunities_title_nonempty": {
          "name": "opportunities_title_nonempty",
          "value": "\"opportunities\".\"title\" ~ '[^[:space:]]'"
        },
        "opportunities_full_text_valid": {
          "name": "opportunities_full_text_valid",
          "value": "public.opportunity_text_array_valid(\"opportunities\".\"full_text\")"
        },
        "opportunities_source_url_https": {
          "name": "opportunities_source_url_https",
          "value": "\"opportunities\".\"source_url\" ~ '^https://[^[:space:]]+$'"
        },
        "opportunities_source_org_nonempty": {
          "name": "opportunities_source_org_nonempty",
          "value": "\"opportunities\".\"source_org\" ~ '[^[:space:]]'"
        },
        "opportunities_jurisdiction_valid": {
          "name": "opportunities_jurisdiction_valid",
          "value": "\"opportunities\".\"jurisdiction\" IN ('Commonwealth', 'Victoria')"
        },
        "opportunities_deadline_finite": {
          "name": "opportunities_deadline_finite",
          "value": "isfinite(\"opportunities\".\"submission_deadline\")"
        },
        "opportunities_deadline_precision_valid": {
          "name": "opportunities_deadline_precision_valid",
          "value": "\"opportunities\".\"submission_deadline_precision\" IN ('datetime', 'month')"
        },
        "opportunities_deadline_month_normalized": {
          "name": "opportunities_deadline_month_normalized",
          "value": "\"opportunities\".\"submission_deadline_precision\" <> 'month' OR (\n    \"opportunities\".\"submission_deadline\" AT TIME ZONE 'UTC' = date_trunc('month', \"opportunities\".\"submission_deadline\" AT TIME ZONE 'UTC')\n    AND EXTRACT(YEAR FROM \"opportunities\".\"submission_deadline\" AT TIME ZONE 'UTC') BETWEEN 1 AND 9999\n  )"
        },
        "opportunities_category_valid": {
          "name": "opportunities_category_valid",
          "value": "public.opportunity_text_array_valid(\"opportunities\".\"category\", TRUE)\n    AND \"opportunities\".\"category\" <@ ARRAY[\n      'Biodiversity & ecosystems', 'Climate change', 'First Nations & cultural heritage',\n      'Water & resources', 'Communities & environment'\n    ]::TEXT[]"
        },
        "opportunities_tags_valid": {
          "name": "opportunities_tags_valid",
          "value": "\"opportunities\".\"tags\" IS NULL OR public.opportunity_text_array_valid(\"opportunities\".\"tags\", TRUE)"
        },
        "opportunities_summary_nonempty": {
          "name": "opportunities_summary_nonempty",
          "value": "\"opportunities\".\"summary\" IS NULL OR \"opportunities\".\"summary\" ~ '[^[:space:]]'"
        },
        "opportunities_location_valid": {
          "name": "opportunities_location_valid",
          "value": "\"opportunities\".\"location\" IS NULL OR (\n    jsonb_typeof(\"opportunities\".\"location\") = 'object'\n    AND jsonb_typeof(\"opportunities\".\"location\" -> 'label') = 'string'\n    AND (\"opportunities\".\"location\" ->> 'label') ~ '[^[:space:]]'\n    AND jsonb_typeof(\"opportunities\".\"location\" -> 'geometry') = 'object'\n    AND \"opportunities\".\"location\" -> 'geometry' ->> 'type' IN ('Point', 'Polygon', 'MultiPolygon')\n    AND jsonb_typeof(\"opportunities\".\"location\" -> 'geometry' -> 'coordinates') = 'array'\n  ) IS TRUE"
        },
        "opportunities_date_order": {
          "name": "opportunities_date_order",
          "value": "\"opportunities\".\"start_date\" IS NULL OR (isfinite(\"opportunities\".\"start_date\") AND \"opportunities\".\"start_date\" <= \"opportunities\".\"submission_deadline\")"
        }
      },
      "isRLSEnabled": false
    },
